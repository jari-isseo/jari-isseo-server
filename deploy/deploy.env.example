# deploy.sh 설정 (선택): 기본값과 다를 때만 deploy/deploy.env 로 복사해서 고친다. deploy.env 는 커밋 금지
#   cp deploy/deploy.env.example deploy/deploy.env

# 서버 접속 (사용자@주소)
DEPLOY_HOST=ubuntu@3.34.70.19
# SSH 키 경로 (Lightsail 기본 키). Git Bash 에서 ~ 는 C:/Users/내이름
DEPLOY_KEY=~/.ssh/LightsailDefaultKey-ap-northeast-2.pem
# 서버의 레포 폴더
DEPLOY_DIR=jari-isseo-server
# 배포할 브랜치
DEPLOY_BRANCH=develop
