# 복사해서 .env로 만들고 값을 채운다 (.env는 커밋 금지)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=jariisseo
DB_USERNAME=root
DB_PASSWORD=

# JWT 서명 키 (#12): 32자 이상 아무 문자열. 사람마다 달라도 되고, 절대 커밋하지 않는다
# 만들기(PowerShell, 암호학적 난수): $b = New-Object byte[] 48; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=

# 손님 공유 링크(shareUrl) 앞부분. 배포 시 실제 도메인으로
PUBLIC_BASE_URL=http://localhost:8080
